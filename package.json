{
  "name": "history-globe",
  "version": "0.4.0",
  "description": "Pick a date, see the world's borders on a 3D globe",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:fetch": "bash pipeline/fetch.sh",
    "data:build": "node pipeline/build.mjs",
    "data:entities": "node pipeline/entities.mjs && node pipeline/entities-search.mjs",
    "build:artifact": "vite build --mode artifact && node pipeline/artifact.mjs",
    "data:rulers": "node pipeline/rulers.mjs",
    "data:search": "node pipeline/search.mjs",
    "data:fonts": "node pipeline/fonts.mjs",
    "data:summaries": "node pipeline/summaries.mjs",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win nsis --x64",
    "dist:android": "vite build && cap sync android && node pipeline/android-build.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "mapshaper": "^0.7.101",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "maplibre-gl": "^5.24.0",
    "topojson-client": "^3.1.0"
  },
  "private": true,
  "license": "GPL-3.0-or-later",
  "allowScripts": {
    "electron@37.10.3": true
  },
  "main": "desktop/main.cjs",
  "productName": "History Globe",
  "author": "Ben",
  "homepage": "https://github.com/thundertiki/history-globe",
  "build": {
    "appId": "io.github.thundertiki.historyglobe",
    "productName": "History Globe",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "History-Globe-Setup-${version}-x64.${ext}"
    }
  }
}
